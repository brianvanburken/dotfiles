--abort-on-unavailable-fragment
--add-metadata
--concurrent-fragments 8
--cookies-from-browser firefox
--embed-subs
--embed-thumbnail
--extractor-args "youtube:player-client=default,-tv_simply;player_js_variant=tv"
--format "bestvideo+bestaudio"
--format-sort res:1440
--no-playlist
--output "%(channel)s/%(title).100B [%(id).50B].%(ext)s"
--path ~/Downloads/Videos/
--restrict-filenames
--retries 3
--sub-langs "en,en-orig,en-US,en-GB"
--trim-filenames 200
--write-auto-subs
--write-subs
