# vim: set ft=gitconfig:
[include]
	# Written by nix/home/git.nix on macOS only; git skips a missing include
	path = ~/.config/git/macos

[push]
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[commit]
	gpgsign = true

[core]
	hooksPath = ~/.config/git/hooks/
	# Don't flag trailing whitespace or CR at EOL as whitespace errors in diffs
	whitespace = -trailing-space,cr-at-eol
	pager = delta

[advice]
	statusHints = false

[alias]
	lastchange = log -p -n 1
	trim = !git remote prune origin && git gc

[rebase]
	autoStash = true
	missingCommitsCheck = warn
	autoSquash = true
	updateRefs = true

[user]
	name = Brian van Burken
	useConfigOnly = true
	email = brianvanburken@users.noreply.github.com

[init]
	defaultBranch = main

[log]
	# Use abbrev SHAs whenever possible/relevant instead of full 40 chars
	abbrevCommit = true

[status]
	branch = true
	showStash = true

[tag]
	# Sort tags as version numbers whenever applicable, so 1.10.2 is AFTER 1.2.0.
	sort = version:refname
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	# Local only, setup/install-macos.sh writes it from GitHub's signing keys
	allowedSignersFile = ~/.ssh/allowed_signers
	# Sign with the first key in the agent, so no key path is configured
	defaultKeyCommand = ssh-add -L

[interactive]
	diffFilter = delta --color-only
	singleKey = true

[delta]
	navigate = true    # use n and N to move between diff sections
	line-numbers = true
	syntax-theme = "ansi"
	commit-style = "raw"
	hunk-header-style = syntax
	minus-style = red
	minus-non-emph-style = red
	minus-emph-style = reverse red
	minus-empty-line-marker-style = normal red
	zero-style = syntax
	plus-style = bold green
	plus-non-emph-style = bold green
	plus-emph-style = reverse green
	plus-empty-line-marker-style = normal green
	grep-file-style = blue
	grep-line-number-style = blue
	whitespace-error-style = reverse magenta

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = plain
	interHunkContext = 10
	algorithm = histogram
	mnemonicPrefix = true

[rerere]
	enabled = true

[fetch]
	parallel = 0
	prune = true
	all = true

[feature]
	manyFiles = true

[branch]
	sort = committerdate
