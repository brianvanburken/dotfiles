#!/bin/sh

readonly RED=$(tput setab 1)
readonly NORMAL=$(tput sgr0)
readonly CONFLICT_MARKERS='<<<<<<<|=======|>>>>>>>'
readonly CHECK=$(git diff --staged | grep "^+" | grep -Ei "$CONFLICT_MARKERS" -c)

if [ "$CHECK" -gt 0 ]
then
    echo "$RED ERROR $NORMAL Conflict markers sill preset in the following files:"
    git diff --staged --name-only -G"$CONFLICT_MARKERS"
    exit 1
fi

if ! gitleaks protect --no-banner --staged --redact &>/dev/null; then
  echo "$RED ERROR $NORMAL gitleaks has detected sensitive information in your changes."
  exit 1
fi

# core.hooksPath replaces .git/hooks entirely rather than adding to it, so
# setting it globally silently disables every repository's own hooks. Run the
# repository hook here so per-project checks still apply.
# --git-path would resolve through core.hooksPath and find this file again.
repository_hook="$(git rev-parse --git-dir)/hooks/pre-commit"

if [ -x "$repository_hook" ]; then
  "$repository_hook" "$@" || exit $?
fi

exit 0
